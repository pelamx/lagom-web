---
import { nav, site } from '../data/site';
import { products } from '../data/products';
import { solutions } from '../data/solutions';
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="brand">
        <img src="/images/site/logo-dark.png" alt={site.name} width="372" height="168" />
        <p>Grundfos yetkili bayii.<br />Pompa ve hidrofor sistemlerinde seçim, tedarik, devreye alma ve servis.</p>
      </div>

      <div>
        <h4>Ürünler</h4>
        <ul>{products.map((p) => <li><a href={`/urunler/${p.slug}`}>{p.name}</a></li>)}</ul>
      </div>

      <div>
        <h4>Uygulama alanları</h4>
        <ul>
          {solutions.map((s) => <li><a href={`/uygulama-alanlari/${s.slug}`}>{s.title}</a></li>)}
          <li><a href="/grundfos">Grundfos yetkili bayii</a></li>
        </ul>
      </div>

      <div>
        <h4>Firma</h4>
        <ul>{nav.slice(2).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </div>
    </div>

    <!-- title block -->
    <div class="antet">
      <div class="cell wide">
        <span>Adres</span>
        <a href={site.mapsHref} target="_blank" rel="noopener">{site.address}</a>
      </div>
      <div class="cell"><span>Telefon</span><a href={site.phoneHref}>{site.phone}</a></div>
      <div class="cell"><span>WhatsApp</span><a href={site.whatsappHref} target="_blank" rel="noopener">{site.whatsapp}</a></div>
      <div class="cell"><span>E-posta</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div class="cell"><span>Çalışma saatleri</span>{site.hours}</div>
      <div class="cell">
        <span>Sosyal</span>
        <div class="social">{site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</div>
      </div>
      <div class="cell"><span>Belge</span>© {new Date().getFullYear()} {site.name}</div>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--rule); padding: 64px 0 40px; font-size: 0.94rem; }
  .cols { display: grid; grid-template-columns: 1.5fr 1fr 1fr 0.8fr; gap: 40px; margin-bottom: 56px; }
  .brand img { height: 36px; width: auto; margin-bottom: 18px; filter: var(--logo-filter); }
  .brand p { color: var(--muted); max-width: 34ch; }
  h4 { font-family: var(--mono); font-size: 0.78rem; font-weight: 400; color: var(--muted); margin-bottom: 14px; letter-spacing: 0; }
  ul { display: grid; gap: 7px; }
  ul a:hover { color: var(--accent); }

  /* 1px gaps over a line-coloured background draw the inner rules */
  .antet {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--rule);
  }
  .cell { padding: 12px 16px 14px; background: var(--surface); display: grid; gap: 2px; align-content: start; }
  .cell.wide { grid-column: span 2; }
  .cell span { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .cell a:hover { color: var(--accent); }
  .social { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
    .antet { grid-template-columns: 1fr 1fr; }
    .cell.wide { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .antet { grid-template-columns: 1fr; }
  }
</style>
