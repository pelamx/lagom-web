---
import { url } from '../lib/url';
import { site } from '../data/site';
import { brands } from '../data/brands';
import { solutions } from '../data/solutions';
import { useT, href } from '../i18n';

const { locale, t } = useT(Astro.url);
const company = [
  { label: t.nav.services, href: href(locale, 'services') },
  { label: t.nav.about, href: href(locale, 'about') },
  { label: t.nav.contact, href: href(locale, 'contact') },
];
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="brand">
        <img src={url('/images/site/logo-dark.png')} alt={site.name} width="372" height="168" />
        <p>{t.footer.blurb[0]}<br />{t.footer.blurb[1]}</p>
      </div>

      <div>
        <h4>{t.footer.products}</h4>
        <ul>{brands.map((b) => <li><a href={href(locale, 'products', undefined, `#${b.slug}`)}>{b.name}</a></li>)}</ul>
      </div>

      <div>
        <h4>{t.footer.solutions}</h4>
        <ul>
          {solutions.map((s) => <li><a href={href(locale, 'solutions', s.id)}>{t.solutionData[s.id as keyof typeof t.solutionData].title}</a></li>)}
          <li><a href={href(locale, 'grundfos')}>{t.footer.grundfos}</a></li>
        </ul>
      </div>

      <div>
        <h4>{t.footer.company}</h4>
        <ul>{company.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </div>
    </div>

    <!-- title block -->
    <div class="antet">
      <div class="cell wide">
        <span>{t.footer.address}</span>
        <a href={site.mapsHref} target="_blank" rel="noopener">{t.site.address}</a>
      </div>
      <div class="cell"><span>{t.footer.phone}</span><a href={site.phoneHref}>{t.site.phone}</a></div>
      <div class="cell"><span>{t.footer.whatsapp}</span><a href={site.whatsappHref} target="_blank" rel="noopener">{t.site.whatsapp}</a></div>
      <div class="cell"><span>{t.footer.email}</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div class="cell"><span>{t.footer.hours}</span>{t.site.hours}</div>
      <div class="cell">
        <span>{t.footer.social}</span>
        <div class="social">{site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</div>
      </div>
      <div class="cell"><span>{t.footer.doc}</span>© {new Date().getFullYear()} {site.name}</div>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--rule); padding: 64px 0 40px; font-size: 0.94rem; }
  .cols { display: grid; grid-template-columns: 1.5fr 1fr 1fr 0.8fr; gap: 40px; margin-bottom: 56px; }
  .brand img { height: 36px; width: auto; margin-bottom: 18px; filter: var(--logo-filter); }
  .brand p { color: var(--muted); max-width: 34ch; }
  h4 { font-family: var(--mono); font-size: 0.78rem; font-weight: 400; color: var(--muted); margin-bottom: 14px; letter-spacing: 0; }
  ul { display: grid; gap: 7px; }
  ul a:hover { color: var(--accent); }

  /* 1px gaps over a line-coloured background draw the inner rules */
  .antet {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--rule);
  }
  .cell { padding: 12px 16px 14px; background: var(--surface); display: grid; gap: 2px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
  .cell.wide { grid-column: span 2; }
  .cell span { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .cell a:hover { color: var(--accent); }
  .social { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
    .antet { grid-template-columns: 1fr 1fr; }
    .cell.wide { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .antet { grid-template-columns: 1fr; }
  }
</style>
