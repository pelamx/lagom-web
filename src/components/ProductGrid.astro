---
import { url } from '../lib/url';
import { productCode, type Product } from '../data/products';
import { useT, href } from '../i18n';

interface Props { products: Product[] }
const { products } = Astro.props;
const { locale, t } = useT(Astro.url);
const text = (p: Product) => t.productData[p.slug as keyof typeof t.productData];
---

<ul class="catalog">
  {products.map((p) => (
    <li>
      <a href={href(locale, 'products', p.slug)}>
        <div class="meta mono">
          <span>{productCode(p)}</span>
          <span>{text(p).category}</span>
        </div>
        <div class="media">
          <img src={url(p.image)} alt={text(p).name} width="600" height="600" loading="lazy" />
        </div>
        <h3>{text(p).name}</h3>
        {text(p).specs.length > 0 && (
          <dl class="mono">
            {text(p).specs.slice(0, 2).map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .catalog {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--line);
  }
  li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-width: 0; }
  a { display: flex; flex-direction: column; height: 100%; padding: 16px 18px 20px; transition: background 0.12s; }
  a:hover { background: var(--surface); }
  .meta { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 0.72rem; }
  .meta span:last-child { text-align: right; }
  .media { aspect-ratio: 10 / 9; margin: 14px 0 18px; padding: 8%; background: var(--media-bg); }
  .media img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  h3 { margin-bottom: 10px; }
  a:hover h3 { color: var(--accent); }
  dl { margin: auto 0 0; font-size: 0.74rem; color: var(--ink-2); }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-top: 1px dashed var(--line); }
  dt { color: var(--muted); }
  dd { margin: 0; text-align: right; }

  @media (max-width: 1100px) { .catalog { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 800px) { .catalog { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) {
    a { padding: 12px 12px 16px; }
    .meta span:last-child { display: none; }
    h3 { font-size: 1.05rem; }
    dl { display: none; }
  }
</style>
