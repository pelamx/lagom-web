---
import { site } from '../data/site';
import { useT, href } from '../i18n';

const { locale, t } = useT(Astro.url);
---

<div class="mobile-bar" role="navigation" aria-label={t.ui.quickContact}>
  <a href={site.phoneHref}>{t.ui.call}</a>
  <a href={site.whatsappHref} target="_blank" rel="noopener">{t.ui.whatsapp}</a>
  <a href={href(locale, 'contact', undefined, '#teklif')} class="accent">{t.ui.quote}</a>
</div>

<style>
  .mobile-bar { display: none; }
  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--bg);
      border-top: 1px solid var(--rule);
    }
    a {
      display: grid;
      place-items: center;
      height: 56px;
      padding: 0 6px;
      font-weight: 500;
      font-size: 0.95rem;
      text-align: center;
      line-height: 1.15;
      border-right: 1px solid var(--line);
    }
    a.accent { background: var(--accent); color: var(--accent-ink); border-right: 0; }
  }
</style>
