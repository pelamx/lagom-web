---
import { url } from '../lib/url';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { useT, href, parse, alternates, languages, type PageKey } from '../i18n';

const { locale, t } = useT(Astro.url);
const current = parse(Astro.url).key;
const nav: { key: PageKey; label: string }[] = [
  { key: 'products', label: t.nav.products },
  { key: 'solutions', label: t.nav.solutions },
  { key: 'services', label: t.nav.services },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];
const langs = alternates(Astro.url);
---

<header class="header">
  <div class="container header-inner">
    <a href={href(locale, 'home')} class="logo" aria-label={`${site.name} ${t.ui.homeAria}`}>
      <img src={url('/images/site/logo-dark.png')} alt={site.name} width="372" height="168" />
    </a>

    <nav class="nav" id="site-nav" aria-label={t.ui.mainMenu}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={href(locale, item.key)} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <button class="nav-theme theme-btn" type="button">
        <span class="i-moon"><Icon name="moon" size={17} /></span>
        <span class="i-sun"><Icon name="sun" size={17} /></span>
        {t.ui.theme}
      </button>
      <div class="nav-contact">
        <a href={site.phoneHref}>{t.site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span class="muted">{t.site.hours}</span>
      </div>
    </nav>

    <div class="actions">
      <div class="langs" role="group" aria-label={t.ui.language}>
        {langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.locale}
            lang={l.locale}
            title={languages[l.locale].name}
            aria-current={l.locale === locale ? 'true' : undefined}
          >{languages[l.locale].label}</a>
        ))}
      </div>
      <button class="square theme-btn" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
        <span class="i-moon"><Icon name="moon" size={17} /></span>
        <span class="i-sun"><Icon name="sun" size={17} /></span>
      </button>
      <a href={href(locale, 'contact', undefined, '#teklif')} class="btn btn-accent btn-sm cta">{t.ui.quote}</a>
      <button class="square menu-btn" type="button" aria-label={t.ui.menu} aria-expanded="false" aria-controls="site-nav">
        <span class="i-open"><Icon name="menu" size={20} /></span>
        <span class="i-close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-btn');
  menu?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    menu.setAttribute('aria-expanded', String(open));
  });

  // A language picked by hand overrides time-zone detection (Base.astro) from now on.
  document.querySelectorAll<HTMLAnchorElement>('.langs a').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', a.hreflang);
      } catch {}
    }),
  );

  const root = document.documentElement;
  document.querySelectorAll('.theme-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    }),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
  }
  /* The blur lives on a pseudo-element: backdrop-filter on .header itself would make it the containing
     block for the fixed mobile menu, squeezing the menu into the header. */
  .header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .header-inner { display: flex; align-items: center; gap: 36px; height: calc(var(--header-h) - 1px); }
  .logo { flex-shrink: 0; display: block; }
  .logo img { width: var(--logo-w); height: auto; filter: var(--logo-filter); }

  .nav { flex: 1; min-width: 0; }
  .nav ul { display: flex; gap: 24px; }
  .nav ul a { font-size: 0.95rem; color: var(--ink-2); padding: 6px 0; border-bottom: 1px solid transparent; white-space: nowrap; transition: color 0.12s, border-color 0.12s; }
  .nav ul a:hover { color: var(--ink); }
  .nav ul a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .nav-contact,
  .nav-theme { display: none; }

  .actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

  /* language switch: a ruled segmented control */
  .langs { display: inline-flex; border: 1px solid var(--line); height: 40px; }
  .langs a {
    display: grid;
    place-items: center;
    min-width: 34px;
    padding: 0 6px;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    transition: color 0.12s, background 0.12s;
  }
  .langs a + a { border-left: 1px solid var(--line); }
  .langs a:hover { color: var(--ink); }
  .langs a[aria-current] { background: var(--ink); color: var(--bg); }

  .square {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    padding: 0;
  }
  .square:hover { border-color: var(--rule); }
  .menu-btn { display: none; }
  .menu-btn .i-close { display: none; }

  /* theme icon: show moon in light, sun in dark */
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: inline; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: inline; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }

  @media (max-width: 1180px) {
    .header-inner { gap: 28px; }
    .nav ul { gap: 18px; }
    .nav ul a { font-size: 0.9rem; }
  }

  @media (max-width: 1120px) {
    .header-inner { justify-content: space-between; gap: 12px; }
    .menu-btn { display: inline-grid; }
    .nav {
      display: none;
      position: fixed;
      top: var(--header-h);
      right: 0;
      bottom: 0;
      left: 0;
      background: var(--bg);
      padding: 8px var(--gutter) 32px;
      overflow-y: auto;
    }
    .nav ul { flex-direction: column; gap: 0; }
    .nav ul a { display: block; font-size: 1.6rem; padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--ink); letter-spacing: -0.02em; white-space: normal; }
    .nav ul a[aria-current='page'] { border-bottom-color: var(--line); color: var(--accent); }
    .nav-contact { display: grid; gap: 8px; margin-top: 28px; font-family: var(--mono); font-size: 0.88rem; }
    :global(body.nav-open) .nav { display: block; }
    :global(body.nav-open) { overflow: hidden; }
    :global(body.nav-open) .menu-btn .i-open { display: none; }
    :global(body.nav-open) .menu-btn .i-close { display: inline; }
  }

  @media (max-width: 600px) {
    .cta { display: none; }
  }
  @media (max-width: 420px) {
    .actions { gap: 6px; }
    .langs { height: 36px; }
    .langs a { min-width: 28px; padding: 0 4px; font-size: 0.7rem; }
    .square { width: 36px; height: 36px; }
  }
  /* Small phones: the full-size logo, language buttons and menu fill the row, so the theme switch moves into the menu. */
  @media (max-width: 400px) {
    .actions .theme-btn { display: none; }
    .nav-theme {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 24px;
      padding: 10px 14px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 0.95rem;
      cursor: pointer;
    }
    .langs a { min-width: 26px; padding: 0 3px; }
  }
  @media (max-width: 350px) {
    .langs a { min-width: 24px; padding: 0 2px; }
    .square { width: 34px; height: 34px; }
  }
</style>
