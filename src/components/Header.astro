---
import { url } from '../lib/url';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === url(href) || path.startsWith(url(href) + '/');
---

<header class="header">
  <div class="container header-inner">
    <a href={url('/')} class="logo" aria-label={`${site.name} ana sayfa`}>
      <img src={url('/images/site/logo-dark.png')} alt={site.name} width="372" height="168" />
    </a>

    <nav class="nav" id="site-nav" aria-label="Ana menü">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav-contact">
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span class="muted">{site.hours}</span>
      </div>
    </nav>

    <div class="actions">
      <a href={site.phoneHref} class="phone mono">{site.phone}</a>
      <button class="square theme-btn" type="button" aria-label="Açık / koyu tema" title="Açık / koyu tema">
        <span class="i-moon"><Icon name="moon" size={17} /></span>
        <span class="i-sun"><Icon name="sun" size={17} /></span>
      </button>
      <a href={url('/iletisim#teklif')} class="btn btn-accent btn-sm cta">Teklif iste</a>
      <button class="square menu-btn" type="button" aria-label="Menü" aria-expanded="false" aria-controls="site-nav">
        <span class="i-open"><Icon name="menu" size={20} /></span>
        <span class="i-close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-btn');
  menu?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    menu.setAttribute('aria-expanded', String(open));
  });

  const root = document.documentElement;
  document.querySelector('.theme-btn')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; gap: 40px; height: 68px; }
  .logo img { height: 34px; width: auto; filter: var(--logo-filter); }

  .nav { flex: 1; }
  .nav ul { display: flex; gap: 28px; }
  .nav ul a { font-size: 0.95rem; color: var(--ink-2); padding: 6px 0; border-bottom: 1px solid transparent; transition: color 0.12s, border-color 0.12s; }
  .nav ul a:hover { color: var(--ink); }
  .nav ul a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .nav-contact { display: none; }

  .actions { display: flex; align-items: center; gap: 10px; }
  .phone { margin-right: 10px; color: var(--ink-2); font-size: 0.85rem; }
  .phone:hover { color: var(--ink); }
  .square {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    padding: 0;
  }
  .square:hover { border-color: var(--rule); }
  .menu-btn { display: none; }
  .menu-btn .i-close { display: none; }

  /* theme icon: show moon in light, sun in dark */
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: inline; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: inline; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }

  @media (max-width: 1100px) {
    .phone { display: none; }
    .nav ul { gap: 20px; }
  }

  @media (max-width: 920px) {
    .header-inner { height: 60px; justify-content: space-between; gap: 16px; }
    .logo img { height: 28px; }
    .menu-btn { display: inline-grid; }
    .nav {
      display: none;
      position: fixed;
      inset: 60px 0 0;
      background: var(--bg);
      padding: 8px var(--gutter) 32px;
      overflow-y: auto;
    }
    .nav ul { flex-direction: column; gap: 0; }
    .nav ul a { display: block; font-size: 1.6rem; padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--ink); letter-spacing: -0.02em; }
    .nav ul a[aria-current='page'] { border-bottom-color: var(--line); color: var(--accent); }
    .nav-contact { display: grid; gap: 8px; margin-top: 28px; font-family: var(--mono); font-size: 0.88rem; }
    :global(body.nav-open) .nav { display: block; }
    :global(body.nav-open) { overflow: hidden; }
    :global(body.nav-open) .menu-btn .i-open { display: none; }
    :global(body.nav-open) .menu-btn .i-close { display: inline; }
  }

  @media (max-width: 480px) {
    .cta { display: none; }
  }
</style>
