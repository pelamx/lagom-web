---
import { url } from '../lib/url';
/**
 * Engineering-drawing title block (antet): a ruled row of label/value cells.
 */
interface Props {
  cells: { label: string; value: string; href?: string }[];
}
const { cells } = Astro.props;
---

<dl class="title-block">
  {cells.map((c) => (
    <div>
      <dt>{c.label}</dt>
      <dd>{c.href ? <a href={url(c.href)}>{c.value}</a> : c.value}</dd>
    </div>
  ))}
</dl>

<style>
  .title-block {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--rule);
  }
  .title-block div { padding: 14px 18px 16px; background: var(--surface); min-width: 0; }
  dt { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); margin-bottom: 4px; }
  dd { margin: 0; font-size: 0.98rem; font-weight: 500; }
  dd a:hover { color: var(--accent); }

  @media (max-width: 860px) {
    .title-block { grid-template-columns: 1fr 1fr; }
  }
</style>
