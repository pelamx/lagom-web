---
import { url } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { useT, parse, alternates, languages, defaultLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { locale, t } = useT(Astro.url);
const { title, description = t.meta.description, image = '/images/site/og-cizim.png' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t.meta.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
const alts = alternates(Astro.url).map((a) => ({ ...a, abs: new URL(a.href, Astro.site).href }));
// Pages without a twin in every language (404) are never switched: their alternates only point at the home pages.
const known = parse(Astro.url).key !== null;
// A copy served under a sub-path (GitHub Pages preview) must not compete with the real domain in search.
const isPreview = import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alts.map((a) => <link rel="alternate" hreflang={a.locale} href={a.abs} />)}
    <link rel="alternate" hreflang="x-default" href={alts.find((a) => a.locale === defaultLocale)!.abs} />
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />

    <!--
      Region from the device time zone (the site is static, so there is no IP to read): Uzbekistan → uz, Russia → ru,
      Türkiye → tr, anywhere else → en. It picks the hero city (CityDrawing) and, below, the language.
    -->
    <script is:inline>
      (() => {
        const ru = 'Kaliningrad Moscow Kirov Volgograd Astrakhan Saratov Ulyanovsk Samara'.split(' ').map((z) => 'Europe/' + z)
          .concat('Yekaterinburg Omsk Novosibirsk Barnaul Tomsk Novokuznetsk Krasnoyarsk Irkutsk Chita Yakutsk Khandyga Vladivostok Ust-Nera Magadan Sakhalin Srednekolymsk Kamchatka Anadyr'.split(' ').map((z) => 'Asia/' + z));
        let tz = '';
        try {
          tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        } catch {}
        if (!tz) return;
        document.documentElement.dataset.region =
          tz === 'Asia/Tashkent' || tz === 'Asia/Samarkand' ? 'uz'
          : ru.includes(tz) ? 'ru'
          : tz === 'Europe/Istanbul' || tz === 'Asia/Istanbul' || tz === 'Turkey' ? 'tr'
          : 'en';
      })();
    </script>
    {
      known && (
        <script is:inline>
          // Open the page in the visitor's language before first paint: a language picked with the TR/EN/RU/UZ buttons
          // (Header) wins, otherwise the region's. Crawlers are left alone so every language stays indexable.
          (() => {
            if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
            const root = document.documentElement;
            let lang = '';
            try {
              lang = localStorage.getItem('lang') || '';
            } catch {}
            if (!['tr', 'en', 'ru', 'uz'].includes(lang)) lang = root.dataset.region || '';
            if (!lang || lang === root.lang) return;
            const alt = document.querySelector(`link[rel="alternate"][hreflang="${lang}"]`);
            // path only: the absolute hreflang URLs name the production domain, the page may be served elsewhere
            if (alt) location.replace(new URL(alt.href).pathname + location.search + location.hash);
          })();
        </script>
      )
    }

    <!-- apply a saved theme before first paint -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[locale].og} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.ui.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    padding: 10px 16px;
  }
  .skip-link:focus { top: 12px; }
</style>
