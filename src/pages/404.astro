---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { useT, href } from '../i18n';

const { locale, t } = useT(Astro.url);
---

<Base title={t.notFound.title}>
  <section class="page-head" style="padding-bottom: var(--section)">
    <div class="container sheet-grid">
      <div class="sheet-label">404</div>
      <div>
        <h1>{t.notFound.title}</h1>
        <p class="lead">{t.notFound.lead}</p>
        <div class="btn-row" style="margin-top: 32px">
          <a href={href(locale, 'home')} class="btn">{t.ui.home}</a>
          <a href={href(locale, 'products')} class="btn">{t.nav.products} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
