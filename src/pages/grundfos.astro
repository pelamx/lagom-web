---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TitleBlock from '../components/TitleBlock.astro';
import ContactSheet from '../components/ContactSheet.astro';

const range = [
  'Hidrofor pompaları',
  'Sirkülasyon pompaları',
  'Dalgıç pompalar',
  'Atık su pompaları',
  'Yangın pompaları',
  'Takviye pompaları',
  'Uçtan emişli pompalar',
  'Dozaj pompaları',
  'Dezenfeksiyon sistemleri',
];
---

<Base title="Grundfos Yetkili Bayii" description="Lagom Mühendislik, İstanbul’da Grundfos yetkili bayii. Orijinal Grundfos ürünleri, satış sonrası destek ve teknik servis.">
  <section class="page-head">
    <div class="container sheet-grid">
      <div class="sheet-label">Grundfos</div>
      <div>
        <h1>Grundfos yetkili bayii</h1>
        <p class="lead">
          Grundfos’un ürün yelpazesini ve uzmanlığını Türkiye’deki projelere taşıyoruz: doğru ürün, orijinal parça, satış sonrası teknik destek.
        </p>
      </div>
    </div>
  </section>

  <div class="container">
    <figure class="photo"><img src={url('/images/site/grundfos.jpg')} alt="Grundfos pompa ürün gamı" /></figure>
    <TitleBlock
      cells={[
        { label: 'Kuruluş', value: '1945, Danimarka' },
        { label: 'Çalışan', value: '19.000+' },
        { label: 'Yıllık üretim', value: '16 milyon+ pompa' },
        { label: 'Dağıtım', value: '50+ ülke' },
      ]}
    />
  </div>

  <section class="sheet" style="margin-top: var(--section)">
    <div class="container sheet-grid">
      <div class="sheet-label">Ürün gamı</div>
      <div class="cols">
        <div class="prose">
          <p>
            Grundfos pompaları ofis, otel ve konutlarda ısıtma, havalandırma ve iklimlendirmede; su temini, atık su ve sulama uygulamalarında
            kullanılır. Firma, pompaların yanı sıra elektrik motorları da üretir.
          </p>
          <p>Bu ürünlerin tamamını tedarik ediyor, projeye uygun olanı seçmenize yardımcı oluyoruz.</p>
          <a href={url('/urunler')} class="link">Öne çıkan ürünler <Icon name="arrow" size={16} /></a>
        </div>
        <ul class="dash-list">{range.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="container sheet-grid">
      <div class="sheet-label">Yetkili bayi</div>
      <div class="cols">
        <p class="big">Yalnızca satış değil; kurulum, bakım ve onarımla ürünün tüm ömrü boyunca destek.</p>
        <div class="prose">
          <p>
            Uzman teknik ekibimiz Grundfos çözümlerinin en verimli şekilde kullanılması için müşterilerimize teknik destek sağlar. Düzenli bakım ve
            onarım hizmetleriyle ürünlerin en iyi durumda ve en yüksek verimle çalışmasını güvence altına alırız.
          </p>
          <p>Endüstriyel ve bireysel her türlü su gereksinimi için, ihtiyaca tam uyan Grundfos çözümünü birlikte belirleriz.</p>
          <a href={url('/hizmetler')} class="link">Hizmetler <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <ContactSheet />
</Base>

<style>
  .photo { margin: 0; aspect-ratio: 21 / 8; overflow: hidden; background: var(--sunk); }
  .photo img { width: 100%; height: 100%; object-fit: cover; filter: var(--photo-filter); }
  .cols { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .prose p { color: var(--ink-2); max-width: 56ch; }
  .prose .link { margin-top: 8px; }
  .big { font-size: clamp(1.45rem, 2.6vw, 2.1rem); line-height: 1.25; letter-spacing: -0.02em; max-width: 24ch; margin: 0; }
  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    .photo { aspect-ratio: 16 / 9; }
  }
</style>
