---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { products, type Product } from '../../data/products';
import { solutions } from '../../data/solutions';
import { site, whatsappWith } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;

const index = products.indexOf(product);
const code = `P-${String(index + 1).padStart(2, '0')}`;
const usedIn = solutions.filter((s) => s.products.includes(product.slug));
const others = [...products.slice(index + 1), ...products.slice(0, index)].slice(0, 4);
const quoteHref = `/iletisim?urun=${encodeURIComponent(product.name)}#teklif`;
---

<Base title={`${product.name} – ${product.category}`} description={product.summary} image={product.image}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Sayfa yolu">
        <a href={url('/')}>Ana sayfa</a><span>/</span><a href={url('/urunler')}>Ürünler</a><span>/</span><span>{code}</span>
      </nav>

      <div class="product">
        <figure class="media">
          <img src={url(product.image)} alt={product.name} width="600" height="600" />
          <figcaption class="mono">{code} · {product.name}</figcaption>
        </figure>

        <div class="info">
          <p class="mono muted">{product.category}</p>
          <h1>{product.name}</h1>
          <p class="lead">{product.summary}</p>

          {product.specs.length > 0 && (
            <dl class="kv">
              {product.specs.map((s) => (
                <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
              ))}
            </dl>
          )}

          <div class="btn-row">
            <a href={url(quoteHref)} class="btn btn-accent">Bu ürün için teklif iste <Icon name="arrow" size={16} /></a>
            <a href={whatsappWith(`Merhaba, ${product.name} hakkında bilgi almak istiyorum.`)} target="_blank" rel="noopener" class="btn">WhatsApp’tan sor</a>
          </div>
          <p class="mono muted">Telefon: <a href={site.phoneHref} class="tel">{site.phone}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="container sheet-grid">
      <div class="sheet-label">Açıklama</div>
      <div class="details">
        <div class="prose">
          {product.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="lists">
          <div>
            <h3>Özellikler</h3>
            <ul class="dash-list">{product.features.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div>
            <h3>Kullanım alanları</h3>
            <ul class="tags">{product.applications.map((a) => <li>{a}</li>)}</ul>
          </div>
          {usedIn.length > 0 && (
            <div>
              <h3>İlgili uygulama alanları</h3>
              <ul class="related">
                {usedIn.map((s) => (
                  <li><a href={url(`/uygulama-alanlari/${s.slug}`)} class="link">{s.title} <Icon name="arrow" size={15} /></a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="container sheet-grid">
      <div class="sheet-label">Diğer ürünler</div>
      <div class="sheet-head">
        <h2>Katalogdan</h2>
        <a href={url('/urunler')} class="link">Tüm ürünler <Icon name="arrow" size={16} /></a>
      </div>
    </div>
    <div class="container">
      <ProductGrid products={others} />
    </div>
  </section>
</Base>

<style>
  .product { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  .media { margin: 0; border: 1px solid var(--rule); background: var(--media-bg); }
  .media img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; padding: 8%; mix-blend-mode: multiply; }
  .media figcaption { border-top: 1px solid var(--line); padding: 10px 14px; color: var(--ink-2); background: var(--surface); }
  .info { display: grid; gap: 20px; align-content: start; padding-top: 8px; }
  .info h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); }
  .info .lead { margin: 0; }
  .tel { color: var(--ink); }
  .tel:hover { color: var(--accent); }

  .details { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .prose p { color: var(--ink-2); font-size: 1.05rem; max-width: 62ch; }
  .lists { display: grid; gap: 36px; align-content: start; }
  .lists h3 { font-family: var(--mono); font-size: 0.8rem; font-weight: 400; color: var(--muted); letter-spacing: 0; margin-bottom: 12px; }
  .related { display: grid; gap: 12px; justify-items: start; }

  @media (max-width: 900px) {
    .product,
    .details { grid-template-columns: 1fr; }
    .media { max-width: 520px; }
  }
</style>
