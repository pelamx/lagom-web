---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactSheet from '../components/ContactSheet.astro';
import { services } from '../data/services';
---

<Base title="Hizmetler" description="Pompa ve hidrofor sistemlerinde seçim, projelendirme, Grundfos ürün tedariki, devreye alma, bakım ve servis.">
  <section class="page-head">
    <div class="container sheet-grid">
      <div class="sheet-label">Hizmetler</div>
      <div>
        <h1>Seçimden bakıma kadar tek muhatap</h1>
        <p class="lead">
          Pompayı satıp bırakmıyoruz. Doğru seçilmesi, doğru kurulması ve uzun yıllar verimli çalışması için sürecin her adımında yanınızdayız.
        </p>
      </div>
    </div>
  </section>

  <section style="padding-bottom: var(--section)">
    <div class="container sheet-grid">
      <div></div>
      <ol class="services">
        {services.map((s, i) => (
          <li>
            <span class="mono muted">{i + 1} / {services.length}</span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sheet">
    <div class="container sheet-grid">
      <div class="sheet-label">Servis kapsamı</div>
      <div class="scope">
        <div>
          <h2>Satış sonrası destek</h2>
          <p class="lead">
            Yetkili bayi olarak Grundfos ürünlerinin uzun ömürlü ve sorunsuz çalışması için düzenli bakım, onarım ve teknik destek sağlıyoruz.
          </p>
          <a href={url('/grundfos')} class="link">Grundfos yetkili bayiliği <Icon name="arrow" size={16} /></a>
        </div>
        <ul class="dash-list">
          <li>Arıza tespiti ve yerinde onarım</li>
          <li>Periyodik bakım</li>
          <li>Orijinal yedek parça temini</li>
          <li>Kullanım ve enerji verimliliği danışmanlığı</li>
          <li>Uzaktan izleme ve kontrol çözümleri</li>
        </ul>
      </div>
    </div>
  </section>

  <ContactSheet title="Servis veya bakım mı gerekiyor? Arayın, en kısa sürede dönelim." />
</Base>

<style>
  .services { border-top: 1px solid var(--rule); }
  .services li {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .services h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .services p { color: var(--ink-2); max-width: 48ch; }
  .scope { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .scope .lead { margin: 18px 0 24px; }
  @media (max-width: 800px) {
    .services li { grid-template-columns: 1fr; gap: 8px; }
    .scope { grid-template-columns: 1fr; }
  }
</style>
